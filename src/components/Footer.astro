---
import theme from '../config/theme.json';
import { getHomeUrl, getPlanUrl, getWhatsappUrl, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const homeUrl = getHomeUrl(locale);
const planUrl = getPlanUrl(locale);
const whatsappUrl = getWhatsappUrl(locale);
const currentYear = new Date().getFullYear();
---

<footer class="bg-obsidian text-ivory/85 mt-24 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-white/10">
      <!-- Brand Column -->
      <div class="md:col-span-5 space-y-4">
        <a href={homeUrl} class="inline-flex items-center gap-3">
          <span class="w-9 h-9 rounded-full bg-white/10 text-ivory flex items-center justify-center border border-mezcal/50">
            <svg viewBox="0 0 28 28" class="w-4 h-4" fill="none" aria-hidden="true">
              <path d="M14 4.5L16.4 11.6L23.5 14L16.4 16.4L14 23.5L11.6 16.4L4.5 14L11.6 11.6L14 4.5Z" fill="#C59B27" />
              <circle cx="14" cy="14" r="2.2" fill="#111111" />
            </svg>
          </span>
          <span class="font-editorial text-2xl font-bold text-white">
            Visit<span class="text-terracotta">CDMX</span><span class="text-ivory/60 font-sans text-xs uppercase tracking-widest ml-1">.travel</span>
          </span>
        </a>
        <p class="text-sm text-ivory/70 leading-relaxed max-w-md">
          {locale === 'es'
            ? 'Experiencias curadas en Ciudad de México con disponibilidad en tiempo real, reserva directa y respaldo operativo de 30 años por SAT Mexico Tours & Travel.'
            : 'Curated Mexico City experiences with real-time availability, instant direct booking, and 30 years of local operational excellence by SAT Mexico Tours & Travel.'}
        </p>
        <div class="inline-flex items-center gap-2 rounded-full bg-white/5 border border-white/10 px-3.5 py-2 text-xs">
          <span class="text-mezcal font-bold">★ {theme.operator.googleRating}</span>
          <span class="text-ivory/80">
            {theme.operator.googleReviewCount.toLocaleString('en-US')}+ {locale === 'es' ? 'Reseñas Verificadas en Google' : 'Verified Google Reviews'}
          </span>
        </div>
      </div>

      <!-- Explore Column -->
      <div class="md:col-span-3 space-y-3">
        <h3 class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-mezcal">
          {locale === 'es' ? 'Explorar CDMX' : 'Explore CDMX'}
        </h3>
        <ul class="space-y-2.5 text-sm text-ivory/75">
          <li><a href={`${homeUrl}#experiences`} class="hover:text-white transition-colors">{locale === 'es' ? 'Los 6 Tours Permanentes' : 'All 6 Signature Tours'}</a></li>
          <li><a href={`${homeUrl}#neighborhoods`} class="hover:text-white transition-colors">{locale === 'es' ? 'Guía por Colonias y Zonas' : 'CDMX Neighborhood Guides'}</a></li>
          <li><a href={`${homeUrl}#seasonal`} class="hover:text-white transition-colors">{locale === 'es' ? 'Día de Muertos en Mixquic' : 'Mixquic Day of the Dead'}</a></li>
          <li><a href={planUrl} class="hover:text-white transition-colors">{locale === 'es' ? 'Traslados Privados (AICM/CDMX)' : 'Private Airport & City Transfers'}</a></li>
        </ul>
      </div>

      <!-- Direct Booking & Payments -->
      <div class="md:col-span-4 space-y-3">
        <h3 class="font-sans text-xs font-semibold uppercase tracking-[0.18em] text-mezcal">
          {locale === 'es' ? 'Pagos y Soporte Directo' : 'Direct Booking & Concierge'}
        </h3>
        <p class="text-sm text-ivory/70 leading-relaxed">
          {locale === 'es'
            ? 'Pagos procesados vía Stripe México (USD y MXN · tarjetas internacionales, Apple/Google Pay, MSI, OXXO y SPEI en MXN). Confirmación instantánea con Bókun.'
            : 'Payments powered by Stripe Mexico (USD & MXN · Visa, Mastercard, Amex, Apple Pay, Google Pay; MSI/OXXO/SPEI in MXN). Instant e-tickets via Bókun.'}
        </p>
        <div class="flex flex-wrap gap-2 pt-1">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold px-4 py-2 transition-colors"
          >
            WhatsApp Concierge
          </a>
          <a
            href="/llms.txt"
            class="inline-flex items-center rounded-full border border-white/15 hover:border-white/40 text-ivory/75 hover:text-white text-xs px-3.5 py-2 transition-colors"
          >
            llms.txt
          </a>
        </div>
        <p class="text-xs text-ivory/50 pt-1">
          Social: <span class="text-ivory/80 font-medium">{theme.destination.socialHandle}</span> (Instagram · TikTok · YouTube · Pinterest)
        </p>
      </div>
    </div>

    <!-- Mandatory FMPT / Independent Brand Disclaimer -->
    <div class="pt-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-xs text-ivory/60">
      <p class="max-w-3xl leading-relaxed border-l-2 border-mezcal/60 pl-3.5 text-ivory/75">
        {theme.operator.disclaimer[locale]}
      </p>
      <p class="shrink-0">
        © {currentYear} {theme.destination.brandName} · {theme.operator.legalName}
      </p>
    </div>
  </div>
</footer>
